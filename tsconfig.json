{
  "compilerOptions": {
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "module": "Node16",
    "outDir": "./lib",
    "pretty": true,
    "rootDir": "./src",
    "types": ["node", "mocha"],
    "strict": true,
    "target": "ES2022",
    "moduleResolution": "Node16"
  },
  "include": ["./src/**/*"],
  "ts-node": {
    "esm": true
  }
}
